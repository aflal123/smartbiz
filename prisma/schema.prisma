// Prisma Schema for SmartBiz V2 (Multi-Tenant SME Business Suite)
// Database: PostgreSQL on Neon

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

generator client {
  provider = "prisma-client-js"
}

// ── ENUMS ─────────────────────────────────────────────────────────────

enum UserRole {
  SUPER_ADMIN
  BUSINESS_OWNER
  MANAGER
  CASHIER
}

enum SubscriptionTier {
  FREE
  STARTER
  PRO
  BUSINESS
}

enum OtpType {
  EMAIL_VERIFICATION
  PASSWORD_RESET
}

enum StockMovementType {
  PURCHASE
  SALE
  RETURN
  ADJUSTMENT
  DAMAGE
  MANUAL_CORRECTION
}

enum PaymentMethod {
  CASH
  CARD
  BANK_TRANSFER
  CREDIT
  OTHER
}

enum SaleStatus {
  COMPLETED
  PARTIAL
  UNPAID
  CANCELLED
}

enum PurchaseStatus {
  PENDING
  ORDERED
  RECEIVED
  CANCELLED
}

enum AIFeature {
  BUSINESS_INSIGHT
  EMAIL_GENERATOR
  MARKETING_GENERATOR
  INVOICE_SUMMARY
  AI_CHAT
}

// ── TENANCY & AUTH ───────────────────────────────────────────────────

model Business {
  id               String           @id @default(uuid())
  name             String
  slug             String           @unique
  email            String?
  phone            String?
  address          String?
  logoUrl          String?
  currency         String           @default("LKR")
  timezone         String           @default("Asia/Colombo")
  taxRate          Decimal          @default(0.00) @db.Decimal(5, 2)
  receiptFooter    String?
  subscriptionTier SubscriptionTier @default(FREE)
  isActive         Boolean          @default(true)
  createdAt        DateTime         @default(now())
  updatedAt        DateTime         @updatedAt

  users             User[]
  categories        Category[]
  products          Product[]
  batches           ProductBatch[]
  stockMovements    StockMovement[]
  customers         Customer[]
  suppliers         Supplier[]
  purchaseOrders    PurchaseOrder[]
  sales             Sale[]
  payments          Payment[]
  expenseCategories ExpenseCategory[]
  expenses          Expense[]
  incomes           Income[]
  aiUsages          AIUsage[]
  auditLogs         AuditLog[]

  @@map("businesses")
}

model User {
  id              String    @id @default(uuid())
  email           String    @unique
  passwordHash    String
  name            String
  phone           String?
  role            UserRole  @default(CASHIER)
  businessId      String?
  isActive        Boolean   @default(true)
  isEmailVerified Boolean   @default(false)
  lastLoginAt     DateTime?
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  business       Business?       @relation(fields: [businessId], references: [id], onDelete: Cascade)
  sales          Sale[]
  stockMovements StockMovement[]
  payments       Payment[]
  expenses       Expense[]
  incomes        Income[]
  aiUsages       AIUsage[]
  auditLogs      AuditLog[]

  @@index([businessId])
  @@index([email])
  @@map("users")
}

model OtpVerification {
  id         String   @id @default(uuid())
  identifier String // email or phone
  hashedOtp  String // SHA-256 hash of OTP
  type       OtpType
  expiresAt  DateTime
  attempts   Int      @default(0)
  isUsed     Boolean  @default(false)
  createdAt  DateTime @default(now())

  @@index([identifier, type])
  @@map("otp_verifications")
}

// ── CATALOG & INVENTORY ─────────────────────────────────────────────

model Category {
  id          String   @id @default(uuid())
  businessId  String
  name        String
  slug        String
  description String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  business Business  @relation(fields: [businessId], references: [id], onDelete: Cascade)
  products Product[]

  @@unique([businessId, name])
  @@index([businessId])
  @@map("categories")
}

model Product {
  id                String   @id @default(uuid())
  businessId        String
  categoryId        String?
  name              String
  sku               String?
  barcode           String?
  description       String?
  costPrice         Decimal  @default(0.00) @db.Decimal(12, 2)
  sellingPrice      Decimal  @default(0.00) @db.Decimal(12, 2)
  stockQuantity     Int      @default(0)
  lowStockThreshold Int      @default(5)
  unit              String   @default("pcs")
  imageUrl          String?
  isActive          Boolean  @default(true)
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  business           Business            @relation(fields: [businessId], references: [id], onDelete: Cascade)
  category           Category?           @relation(fields: [categoryId], references: [id], onDelete: SetNull)
  batches            ProductBatch[]
  stockMovements     StockMovement[]
  saleItems          SaleItem[]
  purchaseOrderItems PurchaseOrderItem[]

  @@unique([businessId, sku])
  @@index([businessId, barcode])
  @@index([businessId, isActive])
  @@map("products")
}

model ProductBatch {
  id                String    @id @default(uuid())
  businessId        String
  productId         String
  batchNumber       String
  costPrice         Decimal   @db.Decimal(12, 2)
  initialQuantity   Int
  remainingQuantity Int
  expiryDate        DateTime?
  receivedDate      DateTime  @default(now())
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt

  business       Business        @relation(fields: [businessId], references: [id], onDelete: Cascade)
  product        Product         @relation(fields: [productId], references: [id], onDelete: Cascade)
  stockMovements StockMovement[]
  saleItems      SaleItem[]

  @@index([businessId, productId])
  @@map("product_batches")
}

model StockMovement {
  id            String            @id @default(uuid())
  businessId    String
  productId     String
  batchId       String?
  type          StockMovementType
  quantity      Int // Positive for additions, negative for deductions
  previousStock Int
  newStock      Int
  referenceId   String? // saleId, poId, or manual ref
  notes         String?
  createdById   String?
  createdAt     DateTime          @default(now())

  business  Business      @relation(fields: [businessId], references: [id], onDelete: Cascade)
  product   Product       @relation(fields: [productId], references: [id], onDelete: Cascade)
  batch     ProductBatch? @relation(fields: [batchId], references: [id], onDelete: SetNull)
  createdBy User?         @relation(fields: [createdById], references: [id], onDelete: SetNull)

  @@index([businessId, productId])
  @@index([businessId, createdAt])
  @@map("stock_movements")
}

// ── CUSTOMERS & SUPPLIERS ───────────────────────────────────────────

model Customer {
  id                 String   @id @default(uuid())
  businessId         String
  name               String
  email              String?
  phone              String?
  address            String?
  outstandingBalance Decimal  @default(0.00) @db.Decimal(12, 2)
  notes              String?
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt

  business Business  @relation(fields: [businessId], references: [id], onDelete: Cascade)
  sales    Sale[]
  payments Payment[]

  @@index([businessId, phone])
  @@index([businessId, name])
  @@map("customers")
}

model Supplier {
  id                 String   @id @default(uuid())
  businessId         String
  name               String
  companyName        String?
  email              String?
  phone              String?
  address            String?
  outstandingBalance Decimal  @default(0.00) @db.Decimal(12, 2)
  notes              String?
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt

  business       Business        @relation(fields: [businessId], references: [id], onDelete: Cascade)
  purchaseOrders PurchaseOrder[]

  @@index([businessId, name])
  @@map("suppliers")
}

model PurchaseOrder {
  id          String         @id @default(uuid())
  businessId  String
  supplierId  String
  orderNumber String
  totalAmount Decimal        @db.Decimal(12, 2)
  status      PurchaseStatus @default(PENDING)
  notes       String?
  createdById String?
  createdAt   DateTime       @default(now())
  updatedAt   DateTime       @updatedAt

  business Business            @relation(fields: [businessId], references: [id], onDelete: Cascade)
  supplier Supplier            @relation(fields: [supplierId], references: [id], onDelete: Cascade)
  items    PurchaseOrderItem[]

  @@unique([businessId, orderNumber])
  @@map("purchase_orders")
}

model PurchaseOrderItem {
  id              String  @id @default(uuid())
  purchaseOrderId String
  productId       String
  quantity        Int
  unitCost        Decimal @db.Decimal(12, 2)
  subtotal        Decimal @db.Decimal(12, 2)

  purchaseOrder PurchaseOrder @relation(fields: [purchaseOrderId], references: [id], onDelete: Cascade)
  product       Product       @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@map("purchase_order_items")
}

// ── SALES & POS ─────────────────────────────────────────────────────

model Sale {
  id             String        @id @default(uuid())
  businessId     String
  invoiceNumber  String
  customerId     String?
  cashierId      String
  subtotal       Decimal       @db.Decimal(12, 2)
  discountAmount Decimal       @default(0.00) @db.Decimal(12, 2)
  taxAmount      Decimal       @default(0.00) @db.Decimal(12, 2)
  totalAmount    Decimal       @db.Decimal(12, 2)
  amountPaid     Decimal       @db.Decimal(12, 2)
  changeAmount   Decimal       @default(0.00) @db.Decimal(12, 2)
  paymentMethod  PaymentMethod @default(CASH)
  status         SaleStatus    @default(COMPLETED)
  notes          String?
  createdAt      DateTime      @default(now())
  updatedAt      DateTime      @updatedAt

  business Business   @relation(fields: [businessId], references: [id], onDelete: Cascade)
  customer Customer?  @relation(fields: [customerId], references: [id], onDelete: SetNull)
  cashier  User       @relation(fields: [cashierId], references: [id], onDelete: Restrict)
  items    SaleItem[]
  payments Payment[]

  @@unique([businessId, invoiceNumber])
  @@index([businessId, createdAt])
  @@index([businessId, cashierId])
  @@index([businessId, customerId])
  @@map("sales")
}

model SaleItem {
  id               String  @id @default(uuid())
  saleId           String
  productId        String
  batchId          String?
  quantity         Int
  unitCostPrice    Decimal @db.Decimal(12, 2)
  unitSellingPrice Decimal @db.Decimal(12, 2)
  discount         Decimal @default(0.00) @db.Decimal(12, 2)
  subtotal         Decimal @db.Decimal(12, 2)
  totalCost        Decimal @db.Decimal(12, 2)
  profit           Decimal @db.Decimal(12, 2)

  sale    Sale          @relation(fields: [saleId], references: [id], onDelete: Cascade)
  product Product       @relation(fields: [productId], references: [id], onDelete: Restrict)
  batch   ProductBatch? @relation(fields: [batchId], references: [id], onDelete: SetNull)

  @@index([saleId])
  @@index([productId])
  @@map("sale_items")
}

model Payment {
  id            String        @id @default(uuid())
  businessId    String
  saleId        String?
  customerId    String?
  amount        Decimal       @db.Decimal(12, 2)
  paymentMethod PaymentMethod
  referenceNote String?
  createdById   String
  createdAt     DateTime      @default(now())

  business  Business  @relation(fields: [businessId], references: [id], onDelete: Cascade)
  sale      Sale?     @relation(fields: [saleId], references: [id], onDelete: SetNull)
  customer  Customer? @relation(fields: [customerId], references: [id], onDelete: SetNull)
  createdBy User      @relation(fields: [createdById], references: [id], onDelete: Restrict)

  @@index([businessId, createdAt])
  @@map("payments")
}

// ── EXPENSES & INCOME ────────────────────────────────────────────────

model ExpenseCategory {
  id         String   @id @default(uuid())
  businessId String
  name       String
  createdAt  DateTime @default(now())

  business Business  @relation(fields: [businessId], references: [id], onDelete: Cascade)
  expenses Expense[]

  @@unique([businessId, name])
  @@map("expense_categories")
}

model Expense {
  id          String   @id @default(uuid())
  businessId  String
  categoryId  String?
  title       String
  amount      Decimal  @db.Decimal(12, 2)
  expenseDate DateTime @default(now())
  receiptUrl  String?
  notes       String?
  createdById String
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  business  Business         @relation(fields: [businessId], references: [id], onDelete: Cascade)
  category  ExpenseCategory? @relation(fields: [categoryId], references: [id], onDelete: SetNull)
  createdBy User             @relation(fields: [createdById], references: [id], onDelete: Restrict)

  @@index([businessId, expenseDate])
  @@map("expenses")
}

model Income {
  id          String   @id @default(uuid())
  businessId  String
  title       String
  amount      Decimal  @db.Decimal(12, 2)
  incomeDate  DateTime @default(now())
  category    String   @default("other")
  notes       String?
  createdById String
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  business  Business @relation(fields: [businessId], references: [id], onDelete: Cascade)
  createdBy User     @relation(fields: [createdById], references: [id], onDelete: Restrict)

  @@index([businessId, incomeDate])
  @@map("incomes")
}

// ── AI USAGE & AUDIT ────────────────────────────────────────────────

model AIUsage {
  id            String    @id @default(uuid())
  businessId    String
  userId        String
  feature       AIFeature
  model         String
  inputTokens   Int
  outputTokens  Int
  estimatedCost Decimal   @default(0.000000) @db.Decimal(10, 6)
  createdAt     DateTime  @default(now())

  business Business @relation(fields: [businessId], references: [id], onDelete: Cascade)
  user     User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([businessId, createdAt])
  @@index([userId])
  @@map("ai_usages")
}

model AuditLog {
  id         String   @id @default(uuid())
  businessId String?
  userId     String?
  action     String
  entityType String
  entityId   String?
  metadata   Json?
  ipAddress  String?
  createdAt  DateTime @default(now())

  business Business? @relation(fields: [businessId], references: [id], onDelete: Cascade)
  user     User?     @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([businessId, createdAt])
  @@index([entityType, entityId])
  @@map("audit_logs")
}
