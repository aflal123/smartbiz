# ==========================================
# SMARTBIZ V2 — ENVIRONMENT CONFIGURATION TEMPLATE
# ==========================================

# 1. DATABASE CONFIGURATION (PostgreSQL - Neon / Supabase / Railway)
# Pooled connection string for serverless runtime (Vercel Server Actions & Route Handlers)
DATABASE_URL="postgresql://username:password@ep-sample-pooler.us-east-2.aws.neon.tech/neondb?sslmode=require&pgbouncer=true"

# Direct non-pooled connection string (Used by Prisma for migrations and schema sync)
DIRECT_URL="postgresql://username:password@ep-sample.us-east-2.aws.neon.tech/neondb?sslmode=require"


# 2. AUTHENTICATION & SECURITY
# Secret key used for signing JWT auth tokens (must be at least 32 characters long)
JWT_SECRET="smartbiz-production-super-secret-jwt-key-min-32-chars-change-this"


# 3. AI ENGINE CONFIGURATION (OpenAI API)
OPENAI_API_KEY="sk-proj-your-openai-api-key-here"
OPENAI_MODEL="gpt-4o-mini"


# 4. APPLICATION URL
# Base URL of your deployed application on Vercel
NEXT_PUBLIC_APP_URL="https://your-smartbiz-app.vercel.app"


# 5. EMAIL / NOTIFICATIONS CONFIGURATION
# Option A: Resend API Key (Recommended for Vercel serverless)
RESEND_API_KEY="re_your_resend_api_key"

# Option B: Gmail SMTP App Password (Optional fallback)
EMAIL_HOST="smtp.gmail.com"
EMAIL_PORT="587"
EMAIL_USER="your-email@gmail.com"
EMAIL_PASS="your-16-character-app-password"
EMAIL_FROM="SmartBiz <your-email@gmail.com>"


# 6. SUPABASE CONFIGURATION (Optional - if using Supabase client features)
NEXT_PUBLIC_SUPABASE_URL="https://your-project-ref.supabase.co"
NEXT_PUBLIC_SUPABASE_ANON_KEY="your-supabase-anon-key"
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY="your-supabase-publishable-key"
