# SmartBiz V2 Environment Variables

# Neon PostgreSQL Database URLs
# DATABASE_URL: Pooled connection string for serverless runtime (Next.js server actions/route handlers)
DATABASE_URL="postgresql://user:password@ep-sample-pooler.us-east-2.aws.neon.tech/smartbiz?sslmode=require&pgbouncer=true"

# DIRECT_URL: Direct non-pooled connection string used for Prisma migrations
DIRECT_URL="postgresql://user:password@ep-sample.us-east-2.aws.neon.tech/smartbiz?sslmode=require"

# JWT Authentication Secret (64+ character random string)
JWT_SECRET="smartbiz-v2-super-secret-jwt-key-change-this-in-production-min-32-bytes"

# OpenAI API Key (Server-side only — never exposed to client)
OPENAI_API_KEY="sk-proj-sample-key"
OPENAI_MODEL="gpt-4o-mini"

# Email Configuration (Nodemailer / Gmail SMTP or Resend)
EMAIL_HOST="smtp.gmail.com"
EMAIL_PORT="587"
EMAIL_USER="sample@gmail.com"
EMAIL_PASS="sample_app_password"
EMAIL_FROM="SmartBiz <noreply@smartbiz.com>"

# Application Base URLs
NEXT_PUBLIC_APP_URL="http://localhost:3000"
